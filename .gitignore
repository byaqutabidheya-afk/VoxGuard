__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Virtual environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Jupyter / Kaggle notebooks ──────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Distribution / packaging ────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ── Testing & coverage ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# ── Ruff / linter caches ────────────────────────────────────────────────────
.ruff_cache/

